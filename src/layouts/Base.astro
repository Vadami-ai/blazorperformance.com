---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Blazor scalability & performance engineering: tools, playbooks, and curated references from a decade of enterprise performance work.' } = Astro.props;
const nav = [
  { href: '/tools/', label: 'Tools' },
  { href: '/playbooks/', label: 'Playbooks' },
  { href: '/resources/', label: 'Resources' },
  { href: '/whats-new/', label: "What's new" },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="BlazorPerformance: What's new" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --bg: #f7f8fa;
      --paper: #ffffff;
      --ink-900: #0b1220;
      --ink-700: #1e293b;
      --ink-600: #334155;
      --ink-500: #475569;
      --ink-400: #64748b;
      --ink-200: #e2e8f0;
      --ink-100: #eef1f5;
      --green: #16a34a;
      --green-soft: #e8f7ee;
      --font-sans: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0b1220;
        --paper: #101a2e;
        --ink-900: #f1f5f9;
        --ink-700: #e2e8f0;
        --ink-600: #cbd5e1;
        --ink-500: #94a3b8;
        --ink-400: #7c8ba1;
        --ink-200: #24324a;
        --ink-100: #1a2740;
        --green: #34d27b;
        --green-soft: #11321f;
      }
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--ink-700);
      font-family: var(--font-sans);
      font-size: 16px;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--green); text-decoration: none; }
    a:hover { text-decoration: underline; }
    code, pre { font-family: var(--font-mono); font-size: 0.88em; }
    pre {
      background: var(--ink-100);
      border: 1px solid var(--ink-200);
      border-radius: 10px;
      padding: 14px 16px;
      overflow-x: auto;
      line-height: 1.55;
    }
    code:not(pre code) {
      background: var(--ink-100);
      border-radius: 5px;
      padding: 1px 5px;
    }
    .wrap { max-width: 1060px; margin: 0 auto; padding: 0 20px; }
    .site-header {
      position: sticky; top: 0; z-index: 50;
      background: color-mix(in srgb, var(--bg) 88%, transparent);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--ink-200);
    }
    .site-header .wrap {
      display: flex; align-items: center; gap: 22px;
      height: 58px;
    }
    .brand {
      display: flex; align-items: center; gap: 9px;
      font-weight: 800; font-size: 15.5px; color: var(--ink-900);
      letter-spacing: -0.01em;
    }
    .brand:hover { text-decoration: none; }
    .brand svg { display: block; }
    .brand .tld { color: var(--green); }
    nav.main { display: flex; gap: 4px; margin-left: auto; flex-wrap: wrap; }
    nav.main a {
      color: var(--ink-500); font-size: 14px; font-weight: 500;
      padding: 6px 11px; border-radius: 8px;
    }
    nav.main a:hover { color: var(--ink-900); background: var(--ink-100); text-decoration: none; }
    nav.main a.active { color: var(--ink-900); background: var(--ink-100); }
    main { min-height: 62vh; padding: 40px 0 64px; }
    .site-footer {
      border-top: 1px solid var(--ink-200);
      padding: 26px 0 40px;
      font-size: 13.5px; color: var(--ink-400);
    }
    .site-footer .wrap { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; }
    .site-footer a { color: var(--ink-500); }
    /* shared building blocks */
    .eyebrow {
      font-size: 12px; font-weight: 700; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--green);
    }
    h1.page-title { font-size: 34px; line-height: 1.2; letter-spacing: -0.02em; color: var(--ink-900); margin: 6px 0 10px; }
    .page-sub { font-size: 17px; color: var(--ink-500); max-width: 46em; }
    .card {
      background: var(--paper);
      border: 1px solid var(--ink-200);
      border-radius: 14px;
      padding: 22px 24px;
    }
    .btn {
      display: inline-block; font-weight: 600; font-size: 14.5px;
      padding: 10px 18px; border-radius: 10px; border: 1px solid var(--ink-200);
      color: var(--ink-900); background: var(--paper);
    }
    .btn:hover { text-decoration: none; border-color: var(--ink-400); }
    .btn-primary { background: var(--ink-900); border-color: var(--ink-900); color: var(--bg); }
    .btn-primary:hover { opacity: 0.92; }
    .btn-green { background: var(--green); border-color: var(--green); color: #fff; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    @media (max-width: 800px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } }
    .newsletter {
      background: var(--green-soft);
      border: 1px solid color-mix(in srgb, var(--green) 30%, transparent);
      border-radius: 14px;
      padding: 22px 24px;
      display: flex; flex-wrap: wrap; gap: 14px; align-items: center; justify-content: space-between;
    }
    .newsletter h3 { color: var(--ink-900); font-size: 17px; }
    .newsletter p { font-size: 14px; color: var(--ink-500); max-width: 34em; }
    /* prose (markdown) */
    .prose { max-width: 45em; }
    .prose h2 { font-size: 24px; color: var(--ink-900); letter-spacing: -0.01em; margin: 36px 0 12px; }
    .prose h3 { font-size: 18.5px; color: var(--ink-900); margin: 26px 0 10px; }
    .prose p, .prose ul, .prose ol { margin-bottom: 14px; }
    .prose ul, .prose ol { padding-left: 24px; }
    .prose li { margin-bottom: 5px; }
    .prose pre { margin: 16px 0; }
    .prose blockquote {
      border-left: 3px solid var(--green);
      padding: 4px 0 4px 16px;
      color: var(--ink-500);
      margin: 16px 0;
    }
    .prose table { border-collapse: collapse; margin: 16px 0; font-size: 14.5px; width: 100%; }
    .prose th, .prose td { border: 1px solid var(--ink-200); padding: 7px 11px; text-align: left; }
    .prose th { background: var(--ink-100); color: var(--ink-900); }
    .prose img { max-width: 100%; border-radius: 10px; border: 1px solid var(--ink-200); }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7" rx="1.5" fill="currentColor" />
          <rect x="14" y="3" width="7" height="7" rx="1.5" fill="currentColor" opacity="0.5" />
          <rect x="3" y="14" width="7" height="7" rx="1.5" fill="currentColor" opacity="0.7" />
          <rect x="14" y="14" width="7" height="7" rx="1.5" fill="#16a34a" />
        </svg>
        BlazorPerformance<span class="tld">.com</span>
      </a>
      <nav class="main">
        {nav.map((item) => (
          <a href={item.href} class={path.startsWith(item.href.replace(/\/$/, '')) ? 'active' : ''}>{item.label}</a>
        ))}
      </nav>
    </div>
  </header>
  <main>
    <div class="wrap">
      <slot />
    </div>
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <span>© Vadami LLC. All rights reserved.</span>
      <span>Powered by <a href="https://vadami.ai">Vadami.ai</a></span>
      <a href="https://github.com/Vadami-ai">GitHub</a>
      <a href="/rss.xml">RSS</a>
      <a href="/work-with-me/">Work with me</a>
    </div>
  </footer>
</body>
</html>
